# Required: supply your own local PostgreSQL connection URL. No credentials here.
DATABASE_URL=""
# Required for rental meetup verification: generate a private random secret
# (at least 32 characters). Never commit it or expose it with NEXT_PUBLIC_*.
MEETUP_CODE_SECRET=""
# Required explicit confirmation window, 60–1800 seconds.
MEETUP_CONFIRMATION_TTL_SECONDS=900

# Optional server booking policy. Missing values retain these defaults.
# Positive base-10 integers only: duration 1–365 days, notes 1–10000 UTF-16 units.
# Empty/malformed values are errors; these do not activate any feature gate.
# BOOKING_MAX_DURATION_DAYS=90
# BOOKING_MAX_NOTES_UNITS=2000

# Optional verification windows (defaults shown; seconds).
# MEETUP_CHALLENGE_TTL_SECONDS=180
# MEETUP_CHECKIN_TTL_SECONDS=600
# Optional isolated tests: supply a NONEXISTING local hustlen_test_* database,
# distinct from DATABASE_URL, using a role allowed to create/drop databases.
# MRT_TEST_DATABASE_URL=""
# MRT_BROWSER_PATH=/absolute/path/to/chromium
# CHROMIUM_PATH=/absolute/path/to/chromium
# MRT_TEST_KEEP_ON_FAILURE=1
# All provisional feature gates stay unset/off. This template grants no activation.

# Append these email settings to your existing .env; preserve DATABASE_URL.
# Disabled by default. Both Next.js and npm run email:worker must use the same settings.
RECOVERY_EMAIL_MODE=disabled
RECOVERY_APP_ORIGIN=http://localhost:3000
RECOVERY_EMAIL_FROM=onboarding@resend.dev
# In resend-test mode, this must be the email associated with your Resend account.
RECOVERY_EMAIL_TEST_RECIPIENT=your-resend-account@example.com
# Secrets: supply locally or through environment settings; never commit or paste in chat.
RESEND_API_KEY=
# Generate a unique 32-byte key, encoded as base64. Keep it stable across restarts.
RECOVERY_EMAIL_ENCRYPTION_KEY=
# Localhost leaves this empty and shares one conservative IP quota.
# Production requires a proxy that strips and overwrites this single-IP header.
RECOVERY_TRUSTED_IP_HEADER=

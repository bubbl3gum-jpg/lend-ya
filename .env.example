# Append these email settings to your existing .env; preserve DATABASE_URL.
# Disabled by default. Both Next.js and npm run email:worker must use the same settings.
RECOVERY_EMAIL_MODE=disabled
RECOVERY_APP_ORIGIN=http://localhost:3000
RECOVERY_EMAIL_FROM=onboarding@resend.dev
# In resend-test mode, this must be the email associated with your Resend account.
RECOVERY_EMAIL_TEST_RECIPIENT=your-resend-account@example.com
# Secrets: supply locally or through environment settings; never commit or paste in chat.
RESEND_API_KEY=
# Generate a unique 32-byte key, encoded as base64. Keep it stable across restarts.
RECOVERY_EMAIL_ENCRYPTION_KEY=
# Localhost leaves this empty and shares one conservative IP quota.
# Production requires a proxy that strips and overwrites this single-IP header.
RECOVERY_TRUSTED_IP_HEADER=

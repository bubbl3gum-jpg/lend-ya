// Batch 4A: inactive proposal/decision history. No execution receipt or executor.
enum StaffChangeState {
  DRAFT
  SUBMITTED
  REJECTED
  CANCELLED
  EXPIRED
  STALE
  APPROVED
  EXECUTED
}
enum StaffReviewRuling {
  REJECT
  SHADOW_ELIGIBLE
  APPROVE
}
model StaffChangeRequest {
  id String @id @default(uuid()) @db.Uuid
  requesterBindingId String @db.Uuid
  requesterPersonId String @db.Uuid
  requesterUserId Int
  action String @db.VarChar(100)
  approvalAction String @db.VarChar(100)
  risk String @default("HIGH") @db.VarChar(16)
  resourceKind String @db.VarChar(32)
  idempotencyKey String @db.Uuid
  correlationId String @unique @db.Uuid
  currentRevision Int @default(0)
  state StaffChangeState @default(DRAFT)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  requesterBinding StaffSessionBinding @relation(fields:[requesterBindingId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  revisions StaffChangeRevision[]
  decisions StaffApprovalDecision[]
  transitions StaffChangeTransition[]
  @@unique([requesterPersonId,idempotencyKey])
}
model StaffChangeRevision {
  requestId String @db.Uuid
  revision Int
  resourceId String @db.VarChar(128)
  audience String @db.VarChar(16)
  resourceVersion BigInt
  evidenceVersion BigInt
  policyVersion String @db.VarChar(80)
  approvalPolicyVersion String @db.VarChar(80)
  requesterAuthorizationVersion BigInt
  payloadRef String @db.Uuid
  payloadDigest String @db.VarChar(64)
  payloadHash String @db.VarChar(64)
  canonicalManifest String @db.VarChar(4096)
  reasonRef String @db.Uuid
  reasonCode String @db.VarChar(32)
  evidenceRefs String[] @db.Uuid
  expiresAt DateTime @db.Timestamp(3)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  request StaffChangeRequest @relation(fields:[requestId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  decisions StaffApprovalDecision[]
  @@id([requestId,revision])
  @@unique([requestId,revision,payloadHash])
}
model StaffApprovalDecision {
  id String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid
  revision Int
  payloadHash String @db.VarChar(64)
  reviewerBindingId String @db.Uuid
  reviewerPersonId String @db.Uuid
  reviewerUserId Int
  reviewerAuthorizationVersion BigInt
  ruling StaffReviewRuling
  rationaleRef String @db.Uuid
  rationaleCode String @db.VarChar(32)
  idempotencyKey String @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(3)
  request StaffChangeRequest @relation(fields:[requestId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  evaluatedRevision StaffChangeRevision @relation(fields:[requestId,revision,payloadHash],references:[requestId,revision,payloadHash],onDelete:Restrict,onUpdate:Restrict)
  reviewerBinding StaffSessionBinding @relation(fields:[reviewerBindingId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([requestId,revision])
}
model StaffChangeTransition {
  id BigInt @id @default(autoincrement())
  requestId String @db.Uuid
  previousState String @db.VarChar(16)
  newState String @db.VarChar(16)
  previousRevision Int
  newRevision Int
  databaseActor String @default(dbgenerated("CURRENT_USER")) @db.VarChar(63)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  request StaffChangeRequest @relation(fields:[requestId],references:[id],onDelete:Restrict,onUpdate:Restrict)
}

// Batch 5A: cryptographic factor state; never staff-role authorization.
enum StaffMfaPurpose {
  ENROLL
  STEP_UP
}
enum StaffMfaChallengeState {
  PENDING
  CONSUMED
  CANCELLED
}
enum StaffMfaEventKind {
  ENROLLMENT_STARTED
  ENROLLED
  CHALLENGE_CANCELLED
  AUTHENTICATION_STARTED
  VERIFIED
  DENIED
  CREDENTIAL_REVOKED
  RECOVERY_BLOCKED
}
model StaffMfaVersion {
  associationId String @id @db.Uuid
  version BigInt @default(1)
  association StaffAccountAssociation @relation(fields:[associationId],references:[id],onDelete:Restrict,onUpdate:Restrict)
}
model StaffMfaCredential {
  id String @id @default(uuid()) @db.Uuid
  associationId String @db.Uuid
  credentialId String @unique @db.VarChar(1400)
  publicKey Bytes
  counter BigInt @default(0)
  rpId String @db.VarChar(253)
  deviceType String @db.VarChar(16)
  backedUp Boolean
  createdAt DateTime @default(now()) @db.Timestamp(3)
  revokedAt DateTime? @db.Timestamp(3)
  association StaffAccountAssociation @relation(fields:[associationId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  assurances StaffMfaAssurance[]
  @@index([associationId,revokedAt])
}
model StaffMfaChallenge {
  id String @id @default(uuid()) @db.Uuid
  associationId String @db.Uuid
  authSessionId Int
  authSessionCreatedAt DateTime @db.Timestamp(3)
  authorizationVersion BigInt
  mfaVersion BigInt
  challengeHash String @unique @db.VarChar(64)
  configHash String @db.VarChar(64)
  purpose StaffMfaPurpose
  state StaffMfaChallengeState @default(PENDING)
  attempts Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  expiresAt DateTime @db.Timestamp(3)
  association StaffAccountAssociation @relation(fields:[associationId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@index([associationId,expiresAt])
}
model StaffMfaAssurance {
  id String @id @default(uuid()) @db.Uuid
  associationId String @db.Uuid
  credentialKey String @db.Uuid
  authSessionId Int
  authSessionCreatedAt DateTime @db.Timestamp(3)
  authorizationVersion BigInt
  mfaVersion BigInt
  policyVersion String @db.VarChar(80)
  configHash String @db.VarChar(64)
  assertionDigest String @unique @db.VarChar(64)
  assurance String @default("WEBAUTHN_UV") @db.VarChar(16)
  verifiedAt DateTime @default(now()) @db.Timestamp(3)
  expiresAt DateTime @db.Timestamp(3)
  credential StaffMfaCredential @relation(fields:[credentialKey],references:[id],onDelete:Restrict,onUpdate:Restrict)
  association StaffAccountAssociation @relation(fields:[associationId],references:[id],onDelete:Restrict,onUpdate:Restrict)
}
model StaffMfaEvent {
  id BigInt @id @default(autoincrement())
  correlationId String @db.Uuid
  associationId String @db.Uuid
  authSessionId Int
  authSessionCreatedAt DateTime @db.Timestamp(3)
  kind StaffMfaEventKind
  challengeId String? @db.Uuid
  credentialKey String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(3)
  association StaffAccountAssociation @relation(fields:[associationId],references:[id],onDelete:Restrict,onUpdate:Restrict)
}
model StaffMfaRateLimit {
  key String @id @db.VarChar(64)
  attempts Int
  expiresAt DateTime @db.Timestamp(3)
}

// Batch 8B: inert development-only intake candidate. No staff access or transitions.
model SupportTicket {
  id String @id @db.Uuid
  requesterUserId Int
  categoryCode String @db.VarChar(32)
  policyVersion String @db.VarChar(80)
  subject String @db.VarChar(120)
  description String @db.VarChar(2000)
  currentState String @db.VarChar(32)
  lifecycleVersion Int
  requestKey String @db.Uuid
  requestHash String @db.VarChar(64)
  initialEventId String @unique @db.Uuid
  bookingId Int?
  listingId Int?
  reportId Int?
  disputeId Int?
  createdAt DateTime @default(now()) @db.Timestamp(3)
  updatedAt DateTime @default(now()) @db.Timestamp(3)
  requester User @relation("SupportRequester",fields:[requesterUserId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  booking Booking? @relation("SupportBooking",fields:[bookingId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  listing Listing? @relation("SupportListing",fields:[listingId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  report ListingReport? @relation("SupportReport",fields:[reportId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  dispute Dispute? @relation("SupportDispute",fields:[disputeId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  initialEvent SupportTicketEvent @relation("SupportInitialEvent",fields:[initialEventId,id,requesterUserId,requestKey,lifecycleVersion],references:[id,ticketId,actorUserId,correlationId,lifecycleVersion],onDelete:NoAction,onUpdate:NoAction,map:"SupportTicket_initial_event_required")
  events SupportTicketEvent[] @relation("SupportTicketEvents")
  channel SupportParticipantChannel? @relation("TicketRequesterChannel")
  @@unique([id,requesterUserId],map:"SupportTicket_requester_identity_key")
  @@unique([id,requesterUserId,requestKey,lifecycleVersion],map:"SupportTicket_identity_key")
  @@unique([requesterUserId,requestKey])
  @@index([requesterUserId,createdAt,id])
}
model SupportTicketEvent {
  id String @id @db.Uuid
  ticketId String @db.Uuid
  actorUserId Int
  eventType String @db.VarChar(32)
  sequence Int
  lifecycleVersion Int
  correlationId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(3)
  actor User @relation("SupportEventActor",fields:[actorUserId],references:[id],onDelete:Restrict,onUpdate:NoAction)
  ticket SupportTicket @relation("SupportTicketEvents",fields:[ticketId,actorUserId,correlationId,lifecycleVersion],references:[id,requesterUserId,requestKey,lifecycleVersion],onDelete:NoAction,onUpdate:NoAction,map:"SupportTicketEvent_parent_fkey")
  initialForTickets SupportTicket[] @relation("SupportInitialEvent")
  @@unique([id,ticketId,actorUserId,correlationId,lifecycleVersion],map:"SupportTicketEvent_initial_key")
  @@unique([ticketId,sequence])
}

// Batch 8C: requester-only private channel/message candidate; no staff audience.
model SupportParticipantChannel {
  id String @id @db.Uuid
  ticketId String @unique @db.Uuid
  participantUserId Int
  relationshipSide String @db.VarChar(24)
  policyVersion String @db.VarChar(80)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  ticket SupportTicket @relation("TicketRequesterChannel",fields:[ticketId,participantUserId],references:[id,requesterUserId],onDelete:Restrict,onUpdate:NoAction,map:"SupportParticipantChannel_requester_fkey")
  messages SupportMessage[] @relation("ChannelRequesterMessages")
  @@unique([ticketId,participantUserId],map:"SupportParticipantChannel_ticket_requester_key")
  @@unique([id,ticketId,participantUserId],map:"SupportParticipantChannel_identity_key")
}
model SupportMessage {
  id String @id @db.Uuid
  channelId String @db.Uuid
  ticketId String @db.Uuid
  authorUserId Int
  requestKey String @db.Uuid
  requestHash String @db.VarChar(64)
  content String @db.VarChar(2000)
  sequence Int
  createdAt DateTime @default(now()) @db.Timestamp(3)
  channel SupportParticipantChannel @relation("ChannelRequesterMessages",fields:[channelId,ticketId,authorUserId],references:[id,ticketId,participantUserId],onDelete:Restrict,onUpdate:NoAction,map:"SupportMessage_channel_author_fkey")
  @@unique([channelId,sequence])
  @@unique([channelId,requestKey])
}


// Owned-development informational notices only; no production publication authority.
model Announcement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title String @db.VarChar(120)
  body String @db.VarChar(4000)
  state String @default("DRAFT") @db.VarChar(16)
  audience String @default("OWNED_TEST_ADMIN") @db.VarChar(32)
  version Int @default(1)
  creatorId Int
  creator User @relation("AnnouncementCreator", fields: [creatorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  startsAt DateTime? @db.Timestamptz(3)
  expiresAt DateTime? @db.Timestamptz(3)
  events AnnouncementEvent[]
  @@index([state, startsAt, expiresAt])
}
model AnnouncementEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  announcementId String @db.Uuid
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  actorId Int
  actor User @relation("AnnouncementActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  action String @db.VarChar(16)
  previousVersion Int
  resultingVersion Int
  requestId String @unique @db.Uuid
  requestHash String @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([announcementId, resultingVersion])
}



  contract StaffCapabilityContract @relation(fields: [action, policyVersion], references: [action, policyVersion], onDelete: Restrict, onUpdate: Restrict)
  issuedBy StaffPerson @relation(fields: [issuedByPersonId], references: [id], onDelete: Restrict, onUpdate: Restrict)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  USER
  ADMIN
}

enum ListingStatus {
  ACTIVE
  INACTIVE
}

enum ListingMediaKind {
  PHOTO
  VIDEO
}

enum ListingReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  HANDOFF_PENDING
  IN_USE
  RETURN_PENDING
  INSPECTION
  COMPLETED
  DISPUTED
  CANCELLED
  ADMIN_CLOSED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

model User {
  displaySettingChanges DevDisplaySetting[] @relation("DisplaySettingActor")
  displaySettingEvents DevDisplaySettingEvent[] @relation("DisplaySettingEventActor")
  announcementsCreated Announcement[] @relation("AnnouncementCreator")
  announcementEvents AnnouncementEvent[] @relation("AnnouncementActor")
  supportTickets SupportTicket[] @relation("SupportRequester")
  supportTicketEvents SupportTicketEvent[] @relation("SupportEventActor")

  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               UserRole @default(USER)
  accountStatus      AccountStatus @default(ACTIVE)
  adminAuditLogs     AdminAuditLog[]
  verificationStatus String   @default("UNVERIFIED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  identityVerified    Boolean          @default(false)
  trustScore          Int?
  confidenceIndicator String?
  reviewsWritten      VerifiedReview[] @relation("ReviewAuthor")
  reviewsReceived     VerifiedReview[] @relation("ReviewSubject")

  chatOwned Conversation[] @relation("ChatOwner")
  chatBorrowed Conversation[] @relation("ChatBorrower")
  chatParticipants ConversationParticipant[]
  chatMessages ChatMessage[]
  chatBlocks UserBlock[] @relation("ChatBlocker")
  chatBlockedBy UserBlock[] @relation("ChatBlocked")
  chatReviewer ChatReviewer?
  chatCasesTarget ChatModerationCase[] @relation("ChatCaseTarget")
  chatCasesReported ChatModerationCase[] @relation("ChatCaseReporter")
  chatCasesAssigned ChatModerationCase[] @relation("ChatCaseReviewer")
  chatReports MessageReport[]
  chatWarnings ChatWarning[]
  listings          Listing[]
  listingReports    ListingReport[]
  bookingsAsOwner   Booking[]              @relation("BookingOwner")
  bookingsAsRenter  Booking[]              @relation("BookingRenter")
  authSessions      AuthSession[]
  handoffsPerformed Handoff[]              @relation("HandoffPerformer")
  handoffsConfirmed Handoff[]              @relation("HandoffConfirmer")
  returnsInitiated  Return[]               @relation("ReturnInitiator")
  returnsConfirmed  Return[]               @relation("ReturnConfirmer")
  disputesOpened    Dispute[]              @relation("DisputeOpener")
  evidencePhotos    BookingEvidencePhoto[]
  staffAssociation StaffAccountAssociation?
}

model AuthSession {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MrtStation {
  canonicalId String? @unique
  nameEn String?
  nameZh String?
  lineCodes String[] @default([])
  operatorIds String[] @default([])
  systemIds String[] @default([])
  operational Boolean @default(false)
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())

  listings ListingStation[]
  bookings Booking[]
}

model Listing {
  supportTickets SupportTicket[] @relation("SupportListing")

  id              Int           @id @default(autoincrement())
  ownerId         Int
  title           String
  description     String
  category        String
  categoryDetails Json?
  price           Decimal       @db.Decimal(12, 2)
  deposit         Decimal?      @db.Decimal(12, 2)
  condition       String
  status          ListingStatus @default(ACTIVE)
  adminRestricted Boolean @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  owner             User             @relation(fields: [ownerId], references: [id])
  conversations Conversation[]
  supportedStations ListingStation[]
  bookings          Booking[]
  media             ListingMedia[]
  reports           ListingReport[]
}

model ListingStation {
  id        Int @id @default(autoincrement())
  listingId Int
  stationId Int

  listing Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  station MrtStation @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([listingId, stationId])
}

model Booking {
  supportTickets SupportTicket[] @relation("SupportBooking")

  id                 Int           @id @default(autoincrement())
  listingId          Int
  ownerId            Int
  renterId           Int
  meetingStationId   Int
  startAt            DateTime
  endAt              DateTime
  status             BookingStatus @default(PENDING)
  dailyPrice         Decimal?      @db.Decimal(12, 2)
  requestKey         String?       @db.VarChar(128)
  requestHash        String?       @db.VarChar(64)
  cancelledBy        Int?
  cancelledAt        DateTime?
  cancellationReason String?
  totalPrice         Decimal       @db.Decimal(12, 2)
  deposit            Decimal?      @db.Decimal(12, 2)
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  listing        Listing                @relation(fields: [listingId], references: [id])
  owner          User                   @relation("BookingOwner", fields: [ownerId], references: [id])
  renter         User                   @relation("BookingRenter", fields: [renterId], references: [id])
  meetingStation MrtStation             @relation(fields: [meetingStationId], references: [id])
  chatMessages ChatMessage[]
  meetup MeetupSession?
  handoff        Handoff?
  return         Return?
  disputes       Dispute[]
  reviews        VerifiedReview[]
  evidencePhotos BookingEvidencePhoto[]

  @@unique([renterId, requestKey])
  @@index([listingId, status])
  @@index([listingId, status, startAt, endAt])
  @@index([ownerId, status])
  @@index([renterId, status])
}

model Handoff {
  ownerConditionConfirmed Boolean   @default(false)
  borrowerConditionNotes  String?
  borrowerChecklist       Json?
  borrowerPhotos          Json?
  id                      Int       @id @default(autoincrement())
  bookingId               Int       @unique
  performedBy             Int
  confirmedBy             Int?
  timestamp               DateTime  @default(now())
  confirmedAt             DateTime?
  photos                  Json?
  checklist               Json?
  serialNumber            String?
  conditionNotes          String?
  conditionConfirmed      Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  performer User    @relation("HandoffPerformer", fields: [performedBy], references: [id])
  confirmer User?   @relation("HandoffConfirmer", fields: [confirmedBy], references: [id])
}

model Return {
  returnConfirmed     Boolean   @default(false)
  inspectedBy         Int?
  inspectedAt         DateTime?
  inspectionAccepted  Boolean?
  inspectionNotes     String?
  inspectionChecklist Json?
  inspectionPhotos    Json?
  id                  Int       @id @default(autoincrement())
  bookingId           Int       @unique
  photos              Json?
  checklist           Json?
  initiatedBy         Int
  confirmedBy         Int?
  timestamp           DateTime  @default(now())
  confirmedAt         DateTime?
  conditionNotes      String?
  conditionConfirmed  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  initiator User    @relation("ReturnInitiator", fields: [initiatedBy], references: [id])
  confirmer User?   @relation("ReturnConfirmer", fields: [confirmedBy], references: [id])
}

model Dispute {
  supportTickets SupportTicket[] @relation("SupportDispute")

  id          Int           @id @default(autoincrement())
  bookingId   Int
  openedBy    Int
  reason      String
  description String
  status      DisputeStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?
  resolvedBy Int?
  finding String?
  decisionSummary String?
  adminNotes String?
  bookingOutcome String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  opener  User    @relation("DisputeOpener", fields: [openedBy], references: [id])

  @@index([status, createdAt])
  @@index([bookingId, createdAt])
}

model ListingMedia {
  id        Int              @id @default(autoincrement())
  listingId Int
  url       String
  mimeType  String
  kind      ListingMediaKind
  createdAt DateTime         @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
}

model ListingReport {
  supportTickets SupportTicket[] @relation("SupportReport")

  id          Int                 @id @default(autoincrement())
  listingId   Int
  reporterId  Int
  reason      String
  description String?
  status      ListingReportStatus @default(OPEN)
  resolvedAt DateTime?
  resolvedBy Int?
  decisionReason String?
  createdAt   DateTime            @default(now())

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  reporter User    @relation(fields: [reporterId], references: [id], onDelete: Restrict)

  @@unique([listingId, reporterId])
  @@index([status, createdAt])
}

model VerifiedReview {
  id        Int      @id @default(autoincrement())
  bookingId Int
  authorId  Int
  subjectId Int
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  subject   User     @relation("ReviewSubject", fields: [subjectId], references: [id], onDelete: Restrict)

  @@unique([bookingId, authorId])
  @@index([subjectId])
}

model BookingEvidencePhoto {
  id         String   @id @default(uuid())
  bookingId  Int
  uploaderId Int
  stage      String   @db.VarChar(24)
  mimeType   String   @db.VarChar(32)
  data       Bytes
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([bookingId, stage])
}

model AdminAuditLog {
  id Int @id @default(autoincrement())
  adminId Int
  action String @db.VarChar(64)
  targetType String @db.VarChar(32)
  targetId Int
  reason String @db.VarChar(2000)
  previousState Json
  newState Json
  createdAt DateTime @default(now())
  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([createdAt, id])
  @@index([targetType, targetId, createdAt])
  @@index([adminId, createdAt])
}

model AuthRateLimit {
  key String @id @db.VarChar(64)
  attempts Int
  expiresAt DateTime
  @@index([expiresAt])
}

enum ChatMessageStatus {
  ALLOWED
  FLAGGED
  HELD
  REJECTED
}

model Conversation {
  lastActivityAt DateTime @default(now())
  @@index([lastActivityAt, id])
  id Int @id @default(autoincrement())
  listingId Int
  ownerId Int
  borrowerId Int
  version Int @default(0)
  createdAt DateTime @default(now())
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  owner User @relation("ChatOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  borrower User @relation("ChatBorrower", fields: [borrowerId], references: [id], onDelete: Restrict)
  participants ConversationParticipant[]
  messages ChatMessage[]
  reports MessageReport[]
  cases ChatModerationCase[]
  @@unique([listingId, ownerId, borrowerId])
  @@index([ownerId, id])
  @@index([borrowerId, id])
}

model ConversationParticipant {
  conversationId Int
  userId Int
  lastReadSequence Int @default(0)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([conversationId, userId])
  @@index([userId, conversationId])
}

model ChatMessage {
  id Int @id @default(autoincrement())
  conversationId Int
  senderId Int
  clientMessageId String @db.VarChar(128)
  requestHash String @db.VarChar(64)
  contentHash String @db.VarChar(64)
  normalizedHash String @db.VarChar(64)
  body String @db.VarChar(4000)
  sequence Int
  updatedSequence Int
  deliverySequence Int?
  status ChatMessageStatus
  categories String[]
  ruleCodes String[]
  policyVersion String @db.VarChar(32)
  bookingId Int?
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender User @relation(fields: [senderId], references: [id], onDelete: Restrict)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  cases ChatModerationCase[]
  reports MessageReport[]
  analysisJobs ChatAnalysisJob[]
  @@unique([senderId, clientMessageId])
  @@unique([conversationId, sequence])
  @@index([conversationId, updatedSequence])
  @@index([conversationId, deliverySequence])
  @@index([senderId, createdAt])
}

model UserBlock {
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())
  blocker User @relation("ChatBlocker", fields: [blockerId], references: [id], onDelete: Restrict)
  blocked User @relation("ChatBlocked", fields: [blockedId], references: [id], onDelete: Restrict)
  @@id([blockerId, blockedId])
}

model ChatReviewer {
  userId Int @id
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model ChatModerationCase {
  id Int @id @default(autoincrement())
  conversationId Int
  messageId Int?
  targetUserId Int
  kind String @db.VarChar(24)
  status String @default("OPEN") @db.VarChar(16)
  category String @db.VarChar(40)
  reporterId Int?
  reportReason String? @db.VarChar(1000)
  evidence Json
  assignedTo Int?
  decision String? @db.VarChar(24)
  decisionReason String? @db.VarChar(2000)
  decisionCategory String? @db.VarChar(40)
  version Int @default(0)
  parentId Int? @unique
  dedupKey String? @unique @db.VarChar(160)
  createdAt DateTime @default(now())
  decidedAt DateTime?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Restrict)
  target User @relation("ChatCaseTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  reporter User? @relation("ChatCaseReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reviewer User? @relation("ChatCaseReviewer", fields: [assignedTo], references: [id], onDelete: Restrict)
  parent ChatModerationCase? @relation("ChatAppeal", fields: [parentId], references: [id], onDelete: Restrict)
  appeal ChatModerationCase? @relation("ChatAppeal")
  reports MessageReport[]
  warnings ChatWarning[]
  @@index([status, id])
  @@index([assignedTo, status, id])
  @@index([targetUserId, id])
  @@index([reporterId, id])
}

model MessageReport {
  id Int @id @default(autoincrement())
  conversationId Int
  messageId Int?
  reporterId Int
  caseId Int
  dedupKey String @unique @db.VarChar(160)
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Restrict)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Restrict)
  moderationCase ChatModerationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  @@index([reporterId, createdAt])
}

model ChatWarning {
  id Int @id @default(autoincrement())
  caseId Int
  userId Int
  reason String @db.VarChar(2000)
  createdAt DateTime @default(now())
  moderationCase ChatModerationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId, id])
}

model ChatRateLimit {
  key String @id @db.VarChar(100)
  attempts Int
  expiresAt DateTime
  @@index([expiresAt])
}

model ChatOutboxEvent {
  id Int @id @default(autoincrement())
  kind String @db.VarChar(40)
  dedupKey String @unique @db.VarChar(160)
  payload Json
  createdAt DateTime @default(now())
  processedAt DateTime?
  @@index([processedAt, id])
}

// Shadow recommendations never authorize enforcement or message delivery.
model ChatAnalysisJob {
  id Int @id @default(autoincrement())
  messageId Int
  analysisVersion String @db.VarChar(32)
  contextMessageIds Int[]
  listingTitle String @db.VarChar(120)
  status String @default("WAITING") @db.VarChar(16)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String? @db.VarChar(36)
  errorCode String? @db.VarChar(32)
  recommendation Json?
  createdAt DateTime @default(now())
  completedAt DateTime?
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  @@unique([messageId, analysisVersion])
  @@index([status, availableAt, id])
}

model MeetupSession {
  bookingId Int @id
  bookingVersion Int @default(0)
  enabledBy Int
  createdAt DateTime @default(now())
  booking Booking @relation(fields:[bookingId], references:[id], onDelete:Restrict, onUpdate:NoAction)
  checkIns MeetupCheckIn[]
  fallbacks MeetupFallback[]
  challenges MeetupChallenge[]
  events MeetupEvent[]
  rates MeetupRate[]
}
model MeetupCheckIn {
  id Int @id @default(autoincrement())
  bookingId Int
  userId Int
  purpose String @db.VarChar(8)
  role String @db.VarChar(8)
  outcome String @db.VarChar(16)
  reason String @db.VarChar(40)
  accuracyMeters Int?
  distanceBand Int?
  policyVersion String @db.VarChar(32)
  requestKey String @db.VarChar(128)
  requestHash String @db.VarChar(64)
  createdAt DateTime @default(now())
  expiresAt DateTime
  session MeetupSession @relation(fields:[bookingId], references:[bookingId], onDelete:Restrict, onUpdate:NoAction)
  ownerFallbacks MeetupFallback[] @relation("FallbackOwnerCheck")
  borrowerFallbacks MeetupFallback[] @relation("FallbackBorrowerCheck")
  ownerChallenges MeetupChallenge[] @relation("ChallengeOwnerCheck")
  borrowerChallenges MeetupChallenge[] @relation("ChallengeBorrowerCheck")
  @@unique([bookingId,userId,purpose,requestKey])
  @@index([bookingId,purpose,userId,id])
}
model MeetupFallback {
  id Int @id @default(autoincrement())
  bookingId Int
  purpose String @db.VarChar(8)
  ownerCheckId Int
  borrowerCheckId Int
  ownerReason String? @db.VarChar(500)
  borrowerReason String? @db.VarChar(500)
  ownerAckAt DateTime?
  borrowerAckAt DateTime?
  createdAt DateTime @default(now())
  expiresAt DateTime
  session MeetupSession @relation(fields:[bookingId], references:[bookingId], onDelete:Restrict, onUpdate:NoAction)
  ownerCheck MeetupCheckIn @relation("FallbackOwnerCheck",fields:[ownerCheckId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  borrowerCheck MeetupCheckIn @relation("FallbackBorrowerCheck",fields:[borrowerCheckId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  challenges MeetupChallenge[]
  @@unique([bookingId,purpose,ownerCheckId,borrowerCheckId], map:"MeetupFallback_check_pair_key")
}
model MeetupChallenge {
  id String @id @db.VarChar(36)
  bookingId Int
  purpose String @db.VarChar(8)
  issuerId Int
  issueKey String @db.VarChar(128)
  verifierId Int
  bookingState String @db.VarChar(32)
  bookingVersion Int
  bookingUpdatedAt DateTime
  ownerCheckId Int
  borrowerCheckId Int
  fallbackId Int?
  tokenHash String @db.VarChar(64)
  codeHash String @db.VarChar(64)
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  consumedAt DateTime?
  confirmationExpiresAt DateTime?
  verificationKey String? @db.VarChar(128)
  verificationHash String? @db.VarChar(64)
  completedAt DateTime?
  completionHash String? @db.VarChar(64)
  attempts Int @default(0)
  session MeetupSession @relation(fields:[bookingId], references:[bookingId], onDelete:Restrict, onUpdate:NoAction)
  ownerCheck MeetupCheckIn @relation("ChallengeOwnerCheck",fields:[ownerCheckId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  borrowerCheck MeetupCheckIn @relation("ChallengeBorrowerCheck",fields:[borrowerCheckId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  fallback MeetupFallback? @relation(fields:[fallbackId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@unique([bookingId,purpose,issueKey])
  @@index([bookingId,purpose,createdAt])
}
model MeetupEvent {
  id Int @id @default(autoincrement())
  bookingId Int
  actorId Int
  purpose String @db.VarChar(8)
  kind String @db.VarChar(40)
  challengeId String? @db.VarChar(36)
  createdAt DateTime @default(now())
  session MeetupSession @relation(fields:[bookingId], references:[bookingId], onDelete:Restrict, onUpdate:NoAction)
  @@index([bookingId,id])
}
model MeetupRate {
  key String @id @db.VarChar(160)
  bookingId Int
  attempts Int @default(0)
  expiresAt DateTime
  session MeetupSession @relation(fields:[bookingId], references:[bookingId], onDelete:Restrict, onUpdate:NoAction)
}

// Batch 3A foundation only. SQL constraints prohibit ACTIVE memberships/grants.
// Human identity is deliberately separate from future nonhuman service principals.
enum StaffHumanVerification {
  UNVERIFIED
  VERIFIED
  REVOKED
}
enum StaffFixedRole {
  SUPER_ADMIN
  OPERATIONS
  SUPPORT
  MODERATOR
}
enum StaffMembershipState {
  DRAFT
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}
enum StaffGrantState {
  DRAFT
  ACTIVE
  REVOKED
  EXPIRED
}
enum StaffAssociationState {
  PENDING
  VERIFIED
  REVOKED
}
enum StaffGrantScope {
  RESOURCE
  ASSIGNED_CASE
  CASE_QUEUE
  PRIVATE_CHANNEL
  LAB
}
model StaffPerson {
  id String @id @default(uuid()) @db.Uuid
  verification StaffHumanVerification @default(UNVERIFIED)
  verificationSubjectHash String? @unique @db.VarChar(64)
  verificationRef String? @db.Uuid
  verifiedAt DateTime? @db.Timestamp(3)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  associations StaffAccountAssociation[]
  memberships StaffMembership[] @relation("StaffSubject")
  proposedMemberships StaffMembership[] @relation("StaffProposer")
  issuedGrants StaffCapabilityGrant[]
  authorization StaffAuthorizationVersion?
  history StaffAuthorizationEvent[]
}
model StaffAccountAssociation {
  mfaVersion StaffMfaVersion?
  mfaCredentials StaffMfaCredential[]
  mfaChallenges StaffMfaChallenge[]
  mfaAssurances StaffMfaAssurance[]
  mfaEvents StaffMfaEvent[]
  stepUps StaffStepUpRecord[]
  sessionBindings StaffSessionBinding[]
  id String @id @default(uuid()) @db.Uuid
  personId String @db.Uuid
  userId Int @unique
  state StaffAssociationState @default(PENDING)
  provenanceRef String @db.Uuid
  verifiedAt DateTime? @db.Timestamp(3)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  person StaffPerson @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@index([personId])
}
model StaffMembership {
  sessionBindings StaffSessionBinding[]
  id String @id @default(uuid()) @db.Uuid
  personId String @db.Uuid
  role StaffFixedRole
  state StaffMembershipState @default(DRAFT)
  proposedByPersonId String @db.Uuid
  provenanceRef String @db.Uuid
  policyVersion String @db.VarChar(80)
  validFrom DateTime @db.Timestamp(3)
  expiresAt DateTime @db.Timestamp(3)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  person StaffPerson @relation("StaffSubject", fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  proposedBy StaffPerson @relation("StaffProposer", fields: [proposedByPersonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grants StaffCapabilityGrant[]
  @@index([personId, state])
}
model StaffAuthorizationVersion {
  personId String @id @db.Uuid
  version BigInt @default(1)
  policyVersion String @db.VarChar(80)
  updatedAt DateTime @default(now()) @db.Timestamp(3)
  person StaffPerson @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}
// Immutable catalogue of *shadow contracts*, not capability grants or activation.
model StaffCapabilityContract {
  action String @db.VarChar(100)
  policyVersion String @db.VarChar(80)
  resourceKind String @db.VarChar(32)
  risk String @db.VarChar(16)
  scope StaffGrantScope
  eligibleRoles StaffFixedRole[]
  blockedPolicy Boolean
  evidence Boolean
  grants StaffCapabilityGrant[]
  @@id([action, policyVersion])
}
model StaffCapabilityGrant {
  id String @id @default(uuid()) @db.Uuid
  membershipId String @db.Uuid
  action String @db.VarChar(100)
  policyVersion String @db.VarChar(80)
  state StaffGrantState @default(DRAFT)
  scope StaffGrantScope
  resourceKind String @db.VarChar(32)
  resourceId String @db.VarChar(128)
  caseId String? @db.VarChar(128)
  channelAudience String? @db.VarChar(16)
  purposeCode String @db.VarChar(32)
  issuedByPersonId String @db.Uuid
  provenanceRef String @db.Uuid
  validFrom DateTime @db.Timestamp(3)
  expiresAt DateTime @db.Timestamp(3)

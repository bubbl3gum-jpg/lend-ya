model StaffAuthorizationEvent {
  id BigInt @id @default(autoincrement())
  personId String @db.Uuid
  authorizationVersion BigInt
  entityKind String @db.VarChar(32)
  entityId String @db.Uuid
  operation String @db.VarChar(16)
  databaseActor String @default(dbgenerated("CURRENT_USER")) @db.VarChar(63)
  provenanceRef String? @db.Uuid
  previousState Json
  newState Json
  createdAt DateTime @default(now()) @db.Timestamp(3)
  person StaffPerson @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([personId, authorizationVersion])
}

// Batch 3C: inspection-only session/attribution records, never live credentials.
enum StaffPendingState {
  PENDING
  REVOKED
}
enum StaffSecurityOutcome {
  DENIED
  FAILED
  SHADOW_COMMITTED
  COMMITTED
}
model StaffStepUpRecord {
  id String @id @default(uuid()) @db.Uuid
  associationId String @db.Uuid
  authSessionId Int
  authSessionCreatedAt DateTime @db.Timestamp(3)
  assurance String @db.VarChar(16)
  issuerRef String @db.Uuid
  proofRef String @unique @db.Uuid
  authenticatedAt DateTime @db.Timestamp(3)
  expiresAt DateTime @db.Timestamp(3)
  state StaffPendingState @default(PENDING)
  revokedAt DateTime? @db.Timestamp(3)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  association StaffAccountAssociation @relation(fields:[associationId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  bindings StaffSessionBinding[]
}
model StaffSessionBinding {
  changeRequests StaffChangeRequest[]
  reviewDecisions StaffApprovalDecision[]
  id String @id @default(uuid()) @db.Uuid
  authSessionId Int
  authSessionCreatedAt DateTime @db.Timestamp(3)
  associationId String @db.Uuid
  membershipId String @db.Uuid
  stepUpId String @db.Uuid
  authorizationVersion BigInt
  policyVersion String @db.VarChar(80)
  expiresAt DateTime @db.Timestamp(3)
  state StaffPendingState @default(PENDING)
  revokedAt DateTime? @db.Timestamp(3)
  provenanceRef String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamp(3)
  association StaffAccountAssociation @relation(fields:[associationId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  membership StaffMembership @relation(fields:[membershipId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  stepUp StaffStepUpRecord @relation(fields:[stepUpId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  events StaffSecurityEvent[]
  @@index([authSessionId,state])
}
model StaffSecurityEvent {
  id BigInt @id @default(autoincrement())
  correlationId String @db.Uuid
  bindingId String? @db.Uuid
  personId String? @db.Uuid
  userId Int?
  authSessionId Int?
  membershipId String? @db.Uuid
  authorizationVersion BigInt?
  policyVersion String @db.VarChar(80)
  action String @db.VarChar(100)
  resourceKind String @db.VarChar(32)
  resourceId String? @db.VarChar(128)
  caseId String? @db.VarChar(128)
  evidenceId String? @db.Uuid
  outcome StaffSecurityOutcome
  reasonCode String @db.VarChar(32)
  databaseActor String @default(dbgenerated("CURRENT_USER")) @db.VarChar(63)
  createdAt DateTime @default(now()) @db.Timestamp(3)
  binding StaffSessionBinding? @relation(fields:[bindingId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@index([correlationId])
  @@index([personId,createdAt])

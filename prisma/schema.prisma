generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ListingType {
  RENTAL
  SERVICE
}

enum ListingStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_USE
  RETURN_PENDING
  COMPLETED
  CANCELLED
}

model User {
  id                Int      @id @default(autoincrement())
  name              String
  email             String   @unique
  passwordHash      String
  role              UserRole @default(USER)
  verificationStatus String   @default("UNVERIFIED")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  listings        Listing[]
  bookingsAsOwner Booking[] @relation("BookingOwner")
  bookingsAsRenter Booking[] @relation("BookingRenter")
  authSessions    AuthSession[]
}

model AuthSession {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MrtStation {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())

  listings ListingStation[]
  bookings Booking[]
}

model Listing {
  id          Int          @id @default(autoincrement())
  ownerId     Int
  title       String
  description String
  category    String
  type        ListingType  @default(RENTAL)
  price       Decimal      @db.Decimal(12, 2)
  deposit     Decimal?     @db.Decimal(12, 2)
  condition   String
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  owner            User            @relation(fields: [ownerId], references: [id])
  supportedStations ListingStation[]
  bookings         Booking[]
}

model ListingStation {
  id        Int @id @default(autoincrement())
  listingId Int
  stationId Int

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  station MrtStation @relation(fields: [stationId], references: [id], onDelete: Restrict)

  @@unique([listingId, stationId])
}

model Booking {
  id               Int          @id @default(autoincrement())
  listingId        Int
  ownerId          Int
  renterId         Int
  meetingStationId Int
  startAt          DateTime
  endAt            DateTime
  status           BookingStatus @default(PENDING)
  totalPrice       Decimal      @db.Decimal(12, 2)
  deposit          Decimal?     @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  listing        Listing     @relation(fields: [listingId], references: [id])
  owner          User        @relation("BookingOwner", fields: [ownerId], references: [id])
  renter         User        @relation("BookingRenter", fields: [renterId], references: [id])
  meetingStation MrtStation  @relation(fields: [meetingStationId], references: [id])

  @@index([listingId, status])
  @@index([ownerId, status])
  @@index([renterId, status])
}
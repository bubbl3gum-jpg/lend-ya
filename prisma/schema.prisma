model DevDisplaySettingEvent {
 id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 key String @db.VarChar(64)
 setting DevDisplaySetting @relation(fields:[key],references:[key],onDelete:Restrict,onUpdate:NoAction)
 action String @db.VarChar(16)
 previousValue Int
 value Int
 previousVersion Int
 version Int
 rollbackVersion Int?
 policy String @default("owned-display-10b-v1") @db.VarChar(32)
